# Claude API key (required)
ANTHROPIC_API_KEY=your-api-key-here

# ElevenLabs API key (optional - needed for video narration)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Replicate API token (optional - needed for AI-generated slide images via Flux)
REPLICATE_API_TOKEN=your-replicate-api-token

# Pexels API key (optional - for web image search in videos, free at https://www.pexels.com/api/)
# If not set, falls back to DuckDuckGo image search (no key needed)
PEXELS_API_KEY=your-pexels-api-key

# Reddit API credentials (optional - needed for Reddit source)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=posting-bot/0.1
